{
  "kind": "collectionType",
  "collectionName": "vehicles",
  "info": {
    "singularName": "vehicle",
    "pluralName": "vehicles",
    "displayName": "Vehicles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Price": {
      "type": "biginteger",
      "required": true
    },
    "Mileage": {
      "type": "biginteger",
      "required": false
    },
    "Engine_Size": {
      "type": "integer",
      "required": true
    },
    "location": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::location.location",
      "inversedBy": "vehicle"
    },
    "Reference_Number": {
      "type": "string"
    },
    "Model_Code": {
      "type": "string"
    },
    "steering_wheel": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::steering-wheel.steering-wheel",
      "inversedBy": "vehicle"
    },
    "Exterior_Color": {
      "type": "string",
      "required": true
    },
    "fuel": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::fuel.fuel",
      "inversedBy": "vehicle"
    },
    "No_Of_Seats": {
      "type": "integer"
    },
    "drive": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::drive.drive",
      "inversedBy": "vehicle"
    },
    "transmission": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::transmission.transmission",
      "inversedBy": "vehicle"
    },
    "Registration_Year": {
      "type": "date"
    },
    "Weight": {
      "type": "integer"
    },
    "condition": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::condition.condition",
      "inversedBy": "vehicle"
    },
    "make": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::make.make",
      "inversedBy": "vehicle"
    },
    "model": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::model.model",
      "inversedBy": "vehicle"
    },
    "body_style": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::body-style.body-style",
      "inversedBy": "vehicle"
    },
    "Seats_Color": {
      "type": "string",
      "required": true
    },
    "features": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feature.feature",
      "mappedBy": "vehicle"
    },
    "Images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "Is_Popular": {
      "type": "boolean",
      "default": false
    }
  }
}
